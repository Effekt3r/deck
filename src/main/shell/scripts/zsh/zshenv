# Deck shell integration. ZDOTDIR points at this folder so zsh reads these
# wrappers; each loads the user's own file from DECK_USER_ZDOTDIR with ZDOTDIR
# as zsh would have it there: unset when the user never set one (it is $HOME
# then), so `ZDOTDIR=${ZDOTDIR:-…}` in their .zshenv still works.
DECK_ZDOTDIR=$ZDOTDIR
if [[ -f "$DECK_USER_ZDOTDIR/.zshenv" ]]; then
  if [[ $DECK_USER_ZDOTDIR == "$HOME" ]]; then unset ZDOTDIR; else ZDOTDIR=$DECK_USER_ZDOTDIR; fi
  . "$DECK_USER_ZDOTDIR/.zshenv"
  DECK_USER_ZDOTDIR=${ZDOTDIR:-$HOME}   # the user's .zshenv may move ZDOTDIR
  ZDOTDIR=$DECK_ZDOTDIR
fi
